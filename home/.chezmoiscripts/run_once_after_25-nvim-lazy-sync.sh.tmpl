{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# ~/.config/nvim is symlinked to config-src/editors/nvim; do the first
# headless plugin sync here (pinned by its lazy-lock.json) so `nvim` isn't
# slow/interactive the first time it's run.
set -euo pipefail

if command -v nvim >/dev/null 2>&1 && [ -d "$HOME/.config/nvim" ]; then
  echo "==> nvim: headless Lazy sync"
  nvim --headless "+Lazy! sync" +qa >/dev/null 2>&1 || true
fi
{{ end -}}
