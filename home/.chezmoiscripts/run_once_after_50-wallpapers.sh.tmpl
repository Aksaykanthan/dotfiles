{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Fetch a curated set of Catppuccin Mocha wallpapers (MIT, zhichaoh/
# catppuccin-wallpapers, pinned to a commit) and set the default one on
# every display. Images are downloaded, not committed, to keep this repo
# small. Switch later with the fish `wall` function.
set -euo pipefail

dir="$HOME/Pictures/Wallpapers/catppuccin"
base="https://raw.githubusercontent.com/zhichaoh/catppuccin-wallpapers/1023077979591cdeca76aae94e0359da1707a60e"
default="clearnight.jpg"

echo "==> wallpapers: downloading Catppuccin set to $dir"
mkdir -p "$dir"
while read -r src; do
  dst="$dir/$(basename "$src" | tr 'A-Z' 'a-z')"
  [ -f "$dst" ] || curl -fsSL "$base/$src" -o "$dst"
done <<'EOF'
landscapes/Clearnight.jpg
landscapes/shaded_landscape.png
landscapes/tropic_island_night.jpg
landscapes/salty_mountains.png
landscapes/forrest.png
landscapes/evening-sky.png
misc/lonely-fish.png
minimalistic/catppuccin_triangle.png
EOF

osascript -e "tell application \"System Events\" to tell every desktop to set picture to POSIX file \"$dir/$default\""
{{ end -}}
