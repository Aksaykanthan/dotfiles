# ========== Appearance ==========
# DevOps Toolbox look (omerxx/dotfiles): Catppuccin Mocha on a translucent,
# blurred window, no decorations - the wallpaper bleeds through.
font-family = "JetBrainsMono Nerd Font"
font-size = 13
background-opacity = 0.85
background-blur = 20
term = "xterm-256color"
mouse-hide-while-typing = true


# Padding
window-padding-x = 10
window-padding-y = 10


# Theme (matches Zellij's catppuccin-mocha)
theme = "Catppuccin Mocha"

# Cursor. Ghostty's shell integration would force a bar cursor at the
# prompt; turn that off so fish's vi-mode cursor shapes (block in normal,
# line in insert) come through.
cursor-style = block
shell-integration-features = no-cursor

# No title bar, traffic-light buttons, or tab strip - Zellij handles tabs/panes
window-decoration = none
macos-titlebar-style = hidden

# Always start inside Zellij; reattach to the "main" session if it exists
command = /opt/homebrew/bin/zellij attach --create main
# Launched from the Dock, Ghostty only has /usr/bin:/bin:... on PATH. The
# Zellij server inherits it, and plugins run commands with the server's env,
# so zsm couldn't find `zoxide` and zjstatus couldn't find Homebrew tools.
env = PATH=/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin




# ========== Keybindings ==========

# Option acts as Alt, so Zellij's Alt+h/j/k/l/n/w/z/... shortcuts and the
# Alt shortcuts in fish/Claude Code/readline actually reach them (otherwise
# Option+h types "˙"). Option+Left/Right stay word jumps: Ghostty's own
# defaults send them as ESC b / ESC f, which Zellij binds to nothing.
macos-option-as-alt = true
keybind = alt+arrow_left=esc:b
keybind = alt+arrow_right=esc:f

# Vim mode: Alt+V enters a modal key table for scrollback navigation
# and search, styled after Vim's normal-mode motions. Ghostty has no
# built-in "vim mode" toggle (as of 1.3) - this composes it from the
# scroll/search/jump actions it does expose. Escape or q returns to
# normal terminal input.
#
# Not included: visual-mode text selection. Ghostty only exposes
# "adjust an existing selection" (mouse-started), not "begin a
# selection from the keyboard cursor" - so a real `v` binding isn't
# possible yet, and faking one would just be broken.
keybind = alt+v=activate_key_table:vim
keybind = vim/escape=deactivate_key_table
keybind = vim/q=deactivate_key_table

# Line/page scroll: j/k, Ctrl+D/Ctrl+U (half page), Ctrl+F/Ctrl+B (page)
keybind = vim/j=scroll_page_lines:1
keybind = vim/k=scroll_page_lines:-1
keybind = vim/ctrl+d=scroll_page_fractional:0.5
keybind = vim/ctrl+u=scroll_page_fractional:-0.5
keybind = vim/ctrl+f=scroll_page_down
keybind = vim/ctrl+b=scroll_page_up

# Jump to top/bottom of scrollback
keybind = vim/g=scroll_to_top
keybind = vim/shift+g=scroll_to_bottom

# `/` searches scrollback; n/N repeat forward/backward
keybind = vim//=start_search
keybind = vim/n=navigate_search:next
keybind = vim/shift+n=navigate_search:previous

# [/] jump to the previous/next shell prompt (requires fish's shell
# integration, already enabled by Ghostty's default shell detection)
keybind = vim/[=jump_to_prompt:-1
keybind = vim/]=jump_to_prompt:1

# y copies the active selection, if any (Vim-style yank)
keybind = performable:vim/y=copy_to_clipboard

