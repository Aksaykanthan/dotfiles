// Zellij terminal multiplexer, styled after DevOps Toolbox (omerxx/dotfiles):
// Catppuccin Mocha, status bar on top (zjstatus), mauve active-pane border,
// a tmux-style Ctrl+a prefix, and vim motions everywhere.
//
// Key model (clear-defaults: nothing here comes from Zellij's stock set):
//   * Alt+<key>     works in EVERY mode, even while locked inside nvim/claude.
//   * Ctrl+a <key>  the "prefix" (tmux mode) - only at the shell prompt.
//   * autolock      flips Zellij to Locked whenever anything but the shell is
//                   in the focused pane, so Ctrl keys reach nvim, fzf,
//                   Claude Code, omp, k9s, ... untouched.
// Option+Left/Right deliberately bind nothing: Ghostty sends them as ESC b /
// ESC f (word jumps), which stock Zellij read as Alt+f = toggle floating pane.
// Alt+? opens a cheat sheet of everything below.

theme "devops-mocha"
default_layout "devops"
// Absolute path: Ghostty launched from the Dock has no /opt/homebrew/bin on PATH.
default_shell "/opt/homebrew/bin/fish"
// Ctrl+s e opens the scrollback here.
scrollback_editor "/opt/homebrew/bin/nvim"

// No first-run noise.
show_startup_tips false
show_release_notes false

// Mouse + clipboard niceties.
mouse_mode true
copy_on_select true
copy_command "pbcopy"
scroll_buffer_size 100000

// Keep sessions around after closing Ghostty so zsm can resurrect them.
on_force_close "detach"
session_serialization true
pane_viewport_serialization true
scrollback_lines_to_serialize 2000

ui {
    pane_frames {
        rounded_corners true
        // The session name already lives in the zjstatus bar.
        hide_session_name true
    }
}

plugins {
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    configuration location="zellij:configuration"
    plugin-manager location="zellij:plugin-manager"
    filepicker location="zellij:strider" {
        cwd "/"
    }

    // Top bar, modeled on omerxx's catppuccin-tmux setup: session pill on
    // the left, tabs as "name | number" pills, mode + git + dir + clock on
    // the right. No bg on the gaps, so Ghostty's blur shows through.
    zjstatus location="https://github.com/dj95/zjstatus/releases/download/v0.25.0/zjstatus.wasm" {
        format_left   "#[bg=#cba6f7,fg=#11111b,bold]  #[bg=#313244,fg=#cdd6f4,bold] {session} #[default] {tabs}"
        format_center ""
        format_right  "{mode}{command_git}#[bg=#f5c2e7,fg=#11111b]  #[bg=#313244,fg=#cdd6f4] {command_dir} #[bg=#89b4fa,fg=#11111b] 󰥔 #[bg=#313244,fg=#cdd6f4]{datetime}"
        format_space  ""
        format_hide_on_overlength "true"
        format_precedence "lrc"

        border_enabled "false"
        hide_frame_for_single_pane "true"

        mode_normal       ""
        mode_locked       "#[bg=#6c7086,fg=#11111b,bold]  LOCKED #[default] "
        mode_tmux         "#[bg=#f38ba8,fg=#11111b,bold]  PREFIX #[default] "
        mode_resize       "#[bg=#f9e2af,fg=#11111b,bold] 󰩨 RESIZE #[default] "
        mode_move         "#[bg=#fab387,fg=#11111b,bold] 󰆾 MOVE #[default] "
        mode_scroll       "#[bg=#89dceb,fg=#11111b,bold] 󰮾 SCROLL #[default] "
        mode_search       "#[bg=#89dceb,fg=#11111b,bold]  SEARCH #[default] "
        mode_enter_search "#[bg=#89dceb,fg=#11111b,bold]  SEARCH #[default] "
        mode_rename_tab   "#[bg=#a6e3a1,fg=#11111b,bold] 󰑕 RENAME #[default] "
        mode_rename_pane  "#[bg=#a6e3a1,fg=#11111b,bold] 󰑕 RENAME #[default] "
        mode_session      "#[bg=#cba6f7,fg=#11111b,bold]  SESSION #[default] "
        mode_pane         "#[bg=#f38ba8,fg=#11111b,bold]  PANE #[default] "
        mode_tab          "#[bg=#f38ba8,fg=#11111b,bold] 󰓩 TAB #[default] "
        mode_prompt       "#[bg=#f38ba8,fg=#11111b,bold] PROMPT #[default] "

        tab_normal              "#[bg=#313244,fg=#cdd6f4] {name} #[bg=#89b4fa,fg=#11111b,bold] {index} #[default] "
        tab_normal_fullscreen   "#[bg=#313244,fg=#cdd6f4] {name} 󰊓 #[bg=#89b4fa,fg=#11111b,bold] {index} #[default] "
        tab_active              "#[bg=#45475a,fg=#cdd6f4,bold] {name}{floating_indicator}{sync_indicator} #[bg=#fab387,fg=#11111b,bold] {index} #[default] "
        tab_active_fullscreen   "#[bg=#45475a,fg=#cdd6f4,bold] {name}{fullscreen_indicator} #[bg=#fab387,fg=#11111b,bold] {index} #[default] "
        tab_active_sync         "#[bg=#45475a,fg=#cdd6f4,bold] {name}{sync_indicator} #[bg=#fab387,fg=#11111b,bold] {index} #[default] "
        tab_rename              "#[bg=#45475a,fg=#a6e3a1,bold] {name} #[bg=#a6e3a1,fg=#11111b,bold] {index} #[default] "
        tab_fullscreen_indicator " 󰊓"
        tab_floating_indicator   " 󰉈"
        tab_sync_indicator       " 󰓦"
        tab_display_count "9"
        tab_truncate_start_format "#[fg=#6c7086] +{count} … "
        tab_truncate_end_format   "#[fg=#6c7086] … +{count} "

        command_git_command     "git rev-parse --abbrev-ref HEAD"
        command_git_format      "#[bg=#a6e3a1,fg=#11111b]  #[bg=#313244,fg=#cdd6f4] {stdout} #[default] "
        command_git_interval    "3"
        command_git_rendermode  "static"
        command_git_cwd         "{focused_pane_cwd}"
        command_git_hideonemptystdout "true"

        command_dir_command     "bash -c 'basename \"$PWD\"'"
        command_dir_format      "{stdout}"
        command_dir_interval    "1"
        command_dir_rendermode  "static"
        command_dir_cwd         "{focused_pane_cwd}"

        datetime          " {format} "
        datetime_format   "%a %d %b %H:%M"
        datetime_timezone "Asia/Kolkata"
    }

    // Headless: switches Normal <-> Locked based on the focused program.
    autolock location="https://github.com/fresh2dev/zellij-autolock/releases/download/0.3.0/zellij-autolock.wasm" {
        is_enabled true
        lock_regex ".*"
        // Shells, prompt tooling, and plugin panes (zsm, room, ...) stay unlocked.
        ignore_regex "^(zellij|sh|bash|zsh|fish|nu|ls|eza|macfetch|oh-my-posh|starship|zoxide|carapace|direnv|\\(atuin\\)|atuin history start.*|zellij:.*|https?:.*|file:.*)$"
    }
}

load_plugins {
    autolock
}

keybinds clear-defaults=true {
    // ---- Every mode, including Locked -------------------------------------
    // Plugins are launched by full URL, not by alias: aliases are fixed when
    // a session starts, so a hot-reloaded config can't resolve new ones.
    shared {
        bind "Alt h" { MoveFocusOrTab "Left"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        bind "Alt l" { MoveFocusOrTab "Right"; }
        bind "Alt n" { NewPane; }
        bind "Alt z" { ToggleFocusFullscreen; }
        bind "Alt w" { ToggleFloatingPanes; }
        bind "Alt e" { TogglePaneEmbedOrFloating; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Alt s" {
            LaunchOrFocusPlugin "https://github.com/liam-mackie/zsm/releases/download/v0.5.0/zsm.wasm" {
                floating true
                move_to_focused_tab true
                session_separator "."
                show_resurrectable_sessions true
            }
        }
        bind "Alt g" {
            LaunchOrFocusPlugin "https://github.com/rvcas/room/releases/download/v1.2.1/room.wasm" {
                floating true
                move_to_focused_tab true
                ignore_case true
                quick_jump true
            }
        }
        bind "Alt ?" {
            LaunchOrFocusPlugin "https://github.com/karimould/zellij-forgot/releases/download/0.4.2/zellij_forgot.wasm" {
                floating true
                move_to_focused_tab true
                LOAD_ZELLIJ_BINDINGS "true"
            }
        }
    }

    // ---- Locked: only the way back out ------------------------------------
    // Not Ctrl+g: Claude Code and omp use it for "edit prompt in $EDITOR".
    locked {
        bind "Alt ." { SwitchToMode "Normal"; }
        // Program autolock doesn't know about? Disable autolock + unlock.
        bind "Alt Shift ." {
            MessagePlugin "autolock" { payload "toggle"; }
            SwitchToMode "Normal"
        }
    }

    // ---- Prompt-only entry points -----------------------------------------
    shared_except "locked" {
        bind "Alt ." { SwitchToMode "Locked"; }
        bind "Alt Shift ." {
            MessagePlugin "autolock" { payload "toggle"; }
            SwitchToMode "Locked"
        }
    }
    shared_except "tmux" "locked" {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
    }
    shared_except "normal" "locked" "entersearch" "renametab" "renamepane" {
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
    }

    // ---- Ctrl+a prefix ----------------------------------------------------
    tmux {
        bind "Ctrl a" { Write 1; SwitchToMode "Normal"; }   // literal ^A
        // panes
        bind "|" "%" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" "\"" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "h" "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "o" { FocusNextPane; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "p" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "f" { TogglePaneFrames; SwitchToMode "Normal"; }
        bind "P" { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "Space" { NextSwapLayout; }
        // tabs
        bind "c" { NewTab; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "b" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "Tab" { ToggleTab; SwitchToMode "Normal"; }
        bind "X" { CloseTab; SwitchToMode "Normal"; }
        bind "<" { MoveTab "Left"; }
        bind ">" { MoveTab "Right"; }
        bind "B" { BreakPane; SwitchToMode "Normal"; }
        bind "S" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        // sub-modes
        bind "r" { SwitchToMode "Resize"; }
        bind "m" { SwitchToMode "Move"; }
        bind "[" "v" { SwitchToMode "Scroll"; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        // sessions + plugins
        bind "s" {
            LaunchOrFocusPlugin "https://github.com/liam-mackie/zsm/releases/download/v0.5.0/zsm.wasm" {
                    floating true
                    move_to_focused_tab true
                    session_separator "."
                    show_resurrectable_sessions true
                }
            SwitchToMode "Normal"
        }
        bind "w" {
            LaunchOrFocusPlugin "zellij:session-manager" { floating true; move_to_focused_tab true; }
            SwitchToMode "Normal"
        }
        bind "g" {
            LaunchOrFocusPlugin "https://github.com/rvcas/room/releases/download/v1.2.1/room.wasm" {
                    floating true
                    move_to_focused_tab true
                    ignore_case true
                    quick_jump true
                }
            SwitchToMode "Normal"
        }
        bind "?" {
            LaunchOrFocusPlugin "https://github.com/karimould/zellij-forgot/releases/download/0.4.2/zellij_forgot.wasm" {
                    floating true
                    move_to_focused_tab true
                    LOAD_ZELLIJ_BINDINGS "true"
                }
            SwitchToMode "Normal"
        }
        bind "y" {
            LaunchOrFocusPlugin "zellij:strider" { floating true; move_to_focused_tab true; }
            SwitchToMode "Normal"
        }
        bind "C" {
            LaunchOrFocusPlugin "zellij:configuration" { floating true; move_to_focused_tab true; }
            SwitchToMode "Normal"
        }
        // television: pick any cable channel (git, docker, k8s, sessions, ...)
        bind "t" {
            Run "/opt/homebrew/bin/tv" "channels" {
                floating true
                close_on_exit true
                name "television"
            }
            SwitchToMode "Normal"
        }
        bind "d" { Detach; }
        bind "Q" { Quit; }
    }

    // ---- Sub-modes (vim motions) ------------------------------------------
    resize {
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }
    move {
        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
        bind "n" "Tab" { MovePane; }
    }
    scroll {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" "d" { HalfPageScrollDown; }
        bind "Ctrl u" "u" { HalfPageScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "G" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "g" { ScrollToTop; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "q" { ScrollToBottom; SwitchToMode "Normal"; }
    }
    search {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" "d" { HalfPageScrollDown; }
        bind "Ctrl u" "u" { HalfPageScrollUp; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "q" { ScrollToBottom; SwitchToMode "Normal"; }
    }
    entersearch {
        bind "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }
    renametab {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
    }
    renamepane {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
    }
}
