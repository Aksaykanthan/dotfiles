{{- $ghHosts := fromYaml (include "config-src/cli/gh/hosts.yml") -}}
{{- $github := index $ghHosts .github.host -}}
[user]
	name = {{ .git.name | quote }}
	email = {{ .git.email | quote }}
[core]
	excludesfile = "{{ .chezmoi.homeDir }}/.config/git/ignore"
	pager = delta
[include]
	path = "{{ .chezmoi.homeDir }}/.config/git/delta-catppuccin.gitconfig"
[interactive]
	diffFilter = delta --color-only
[delta]
	# Syntax-highlighted, word-level diffs with line numbers. n/N jump
	# between files in the pager; `git diff | delta -s` for side-by-side.
	features = catppuccin-mocha
	navigate = true
	line-numbers = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[github]
	username = {{ index $github "user" | quote }}
	protocol = {{ index $github "git_protocol" | quote }}
[pull]
	rebase = true
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status -sb
	unstage = restore --staged
	last = log -1 HEAD --stat
	amend = commit --amend --no-edit
	undo = reset --soft HEAD~1
	lg = log --graph --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	fixup = "!f() { git commit --fixup=$1; }; f"
	sync = "!f() { git fetch --all --prune && git rebase origin/$(git rev-parse --abbrev-ref HEAD); }; f"
